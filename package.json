{
  "name": "mta-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for NYC subway service alerts, elevator and escalator outages, and station lookup, from MTA's public feeds. Build from source; not on npm; status alpha.",
  "license": "MIT",
  "author": "BetaNYC",
  "homepage": "https://github.com/BetaNYC/mta-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetaNYC/mta-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/BetaNYC/mta-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/mta.test.js test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "stations": "node scripts/update-stations.mjs",
    "accessibility-data": "node scripts/update-accessibility-data.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
